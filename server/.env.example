PORT=9182
HTTPS_PROXY=http://127.0.0.1:7993
ADMIN_TOKEN=change-me-admin-token
DEFAULT_DAILY_CREDIT_LIMIT=100

# Server-side model pool. Multiple keys can be comma-separated.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions
OPENAI_COMPATIBLE_BASE_URL=

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1/messages

GEMINI_API_KEY=
GEMINI_BASE_URL=

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1/chat/completions

# Advanced JSON pool. Example:
# MODEL_POOL_JSON=[{"name":"openrouter-1","provider":"openai-compatible","endpoint":"https://openrouter.ai/api/v1/chat/completions","apiKey":"sk-or-...","models":["*"],"weight":1}]
MODEL_POOL_JSON=

# Persistent JSON database path. Default: server/data/db.json
DATA_DIR=
DB_PATH=
