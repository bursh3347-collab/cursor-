{
  "name": "cursor-style-ai-worker",
  "displayName": "Cursor-style AI Worker",
  "description": "License-gated AI Worker sidebar for VS Code and Cursor.",
  "version": "0.1.0",
  "publisher": "xiahuaxian",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": ["Other"],
  "activationEvents": ["onCommand:aiWorker.openUserCenter"],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "aiWorker.openUserCenter",
        "title": "Open AI Worker User Center"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "latest",
    "@types/vscode": "latest",
    "typescript": "latest"
  }
}
